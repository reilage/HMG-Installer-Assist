# Copy to .env for local testing (npm run dev). On Vercel, set these under Project > Settings > Environment Variables.

# Required for Ask: your Anthropic API key, from https://console.anthropic.com (Settings > API keys)
ANTHROPIC_API_KEY=

# Recommended: a shared code installers type once on their phone. Leave empty for no code.
APP_ACCESS_CODE=

# Installer accounts: the password for the admin page (/admin.html), where you add installers and get their personal codes.
# Leave empty to keep using only the shared code above.
ADMIN_CODE=

# Ask questions each installer (or each phone, without an account) may send per day (resets at midnight Irish time). 0 = no limit.
# DAILY_QUESTION_LIMIT=5
# For a firm limit on Vercel, connect an Upstash Redis store (Vercel adds these two itself)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional: change the Claude model or effort used for Ask (defaults shown)
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
# CLAUDE_EXTRACT_MODEL=claude-haiku-5-5
# Set to "off" only if Anthropic rejects the automatic fallback setting on your account
# CLAUDE_FALLBACKS=

# Optional: send escalations by email from the app (https://resend.com). Without these the app uses a mailto link.
# RESEND_API_KEY=
# ESCALATION_FROM=HMG Installer Assistant <siteassist@heatmerchants.ie>
# ESCALATION_TO=donal.reilly@heatmerchants.ie
# Where installers' access requests go for approval (defaults to ESCALATION_TO)
# APPROVAL_TO=donal.reilly@heatmerchants.ie
